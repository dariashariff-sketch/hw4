# Copy this file to hw4/.env and fill in your own values. Never commit the real .env.

# Portkey gateway key (OpenAI-compatible); the agent calls gpt-5.6-luna through it
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: use a different model than the default gpt-5.6-luna
# CC_MODEL=gpt-5.6-luna

# Optional: where the data pack lives (folder containing campus_customs.db and products/).
# Default: hw4/data/, then the folder next to hw4/.
# CC_DATA_DIR=/path/to/data
